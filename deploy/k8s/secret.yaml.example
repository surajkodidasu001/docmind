apiVersion: v1
kind: Secret
metadata:
  name: docmind-secrets
type: Opaque
stringData:
  ANTHROPIC_API_KEY: "replace-me"
  QDRANT_LOCATION: "http://qdrant:6333"   # point at a real Qdrant deployment, not :memory:
  TENANT_API_KEYS: "replace-me:tenant-a,replace-me2:tenant-b"  # if multi-tenancy is enabled
